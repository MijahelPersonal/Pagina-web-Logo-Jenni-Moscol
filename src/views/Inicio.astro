---
import heroImgAsset from '../assets/imagenes-inicio/hero-logopeda.jpg';
const heroImg = heroImgAsset.src;
import foto1Asset from '../assets/imagenes-inicio/imagen-1.jpg';
const foto1 = foto1Asset.src;
import foto2Asset from '../assets/imagenes-inicio/imagen-2.jpg';
const foto2 = foto2Asset.src;
import foto3Asset from '../assets/imagenes-inicio/imagen-3.jpg';
const foto3 = foto3Asset.src;
import foto4Asset from '../assets/imagenes-inicio/imagen-4.jpg';
const foto4 = foto4Asset.src;
import foto5Asset from '../assets/imagenes-inicio/imagen-5.jpg';
const foto5 = foto5Asset.src;
import card1Asset from '../assets/imagenes-inicio/card1.jpg';
const card1 = card1Asset.src;
import card2Asset from '../assets/imagenes-inicio/card2.jpg';
const card2 = card2Asset.src;
import card3Asset from '../assets/imagenes-inicio/card3.jpg';
const card3 = card3Asset.src;
import card4Asset from '../assets/imagenes-inicio/card4.jpg';
const card4 = card4Asset.src;
import ter1Asset from '../assets/imagenes-inicio/terapia1.jpg';
const ter1 = ter1Asset.src;
import ter2Asset from '../assets/imagenes-inicio/terapia2.jpg';
const ter2 = ter2Asset.src;
import ter3Asset from '../assets/imagenes-inicio/terapia3.jpg';
const ter3 = ter3Asset.src;
const especialidades = [
    "Habla y Lenguaje",
    "Motricidad Orofacial",
    "Voz",
    "Deglución"
  ];
const photos = [ter1, ter2, ter3];
const index = 0, fade = true, currentPhoto = 0;
---
<div class="inicio-container">

      <!-- ===========================
          1. HERO SECTION
      =========================== -->
      <section class="hero" style={{ 'background-image': `url(${heroImg})` }}>
        <div class="hero-container-inner">

          <div class="hero-content">
            <span class="hero-subtitle">
              TECNÓLOGO MÉDICO EN T. DE LENGUAJE (PERÚ) - LOGOPEDA (ESPAÑA)
            </span>

            <h1>
              Terapia especializada en: <br/>
              <span class={`typing-text ${fade ? "fade-in" : "fade-out"}`}>
                {especialidades[index]}
              </span>
            </h1>

            <div class="hero-buttons">
              <a href="#servicios" class="btn-hero">
                ¿Quieres conocer más?
              </a>
            </div>
          </div>

          <!-- Redes Sociales con SVG Transparentes -->
          <div class="hero-socials-lateral">
            <div class="hero-social-icons">
              <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
              <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
              <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
              </a>
              <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
              </a>
            </div>
          </div>

        </div>
      </section>

      <!-- ===========================
          2. WAVE DIVIDER
      =========================== -->
      <div class="wave-divider">
        <svg viewBox="0 0 1440 200" preserveAspectRatio="none">
          <path class="wave-back" d="M0,40 C320,160 800,-20 1440,100 L1440,200 L0,200 Z" />
          <path class="wave-mid" d="M0,110 C480,-10 960,170 1440,60 L1440,200 L0,200 Z" />
          <path class="wave-front" d="M0,80 C360,180 1080,20 1440,110 L1440,200 L0,200 Z" />
        </svg>
      </div>

<!-- ===========================
    3. FILOSOFÍA / PROPUESTA DE VALOR (PARA LA PÁGINA DE INICIO)
=========================== -->
<section class="mini-about" id="sobre-mi">
  <div class="about-content-wrapper">

    <!-- COLUMNA IZQUIERDA: ENFOQUE DE INICIO / SOLUCIONES -->
    <div class="about-text">
      <span class="about-subtitle">MI COMPROMISO</span>
      <h2>Potenciamos la comunicación y el desarrollo del lenguaje</h2>

      <p class="about-paragraph-main">
        Cada persona aprende, comunica y se expresa de manera única. Mi propósito es brindar un acompañamiento
        terapéutico que transforme las dificultades en herramientas de confianza para la vida diaria,
        ya sea en niños que están iniciando su habla o adultos que buscan recuperar su comunicación.
      </p>

      <div class="about-features-grid">
        <div class="about-feature-item">
          <span class="feature-bullet">✦</span>
          <p><strong>Evaluación e Intervención Integral:</strong> Estrategias diseñadas según las necesidades reales del paciente.</p>
        </div>
        <div class="about-feature-item">
          <span class="feature-bullet">✦</span>
          <p><strong>Riesgo Cero en Casa:</strong> Guías y pautas prácticas para que la familia acompañe el progreso día a día.</p>
        </div>
        <div class="about-feature-item">
          <span class="feature-bullet">✦</span>
          <p><strong>Sesiones Dinámicas y Motivadoras:</strong> Métodos interactivos que mantienen el interés y aceleran el avance.</p>
        </div>
        <div class="about-feature-item">
          <span class="feature-bullet">✦</span>
          <p><strong>Respaldo Profesional Oficial:</strong> Atención liderada por una Tecnóloga Médica en Terapia de Lenguaje y Logopeda en España.</p>
        </div>
      </div>
    </div>

    <!-- COLUMNA DERECHA: TARJETA DE GALERÍA FLOTANTE -->
    <div class="about-image-container">
      <div class="about-card-wrapper">
        <div class="about-slider-frame">
          {photos.map((photo, indexPhoto) => (
            <img
              src={photo}
              alt={`Terapia ${indexPhoto + 1}`}
              class={`slider-img ${indexPhoto === currentPhoto ? 'active' : ''}`}
            />
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

      <!-- ===========================
          4. MANIFIESTO + MARQUEE
      =========================== -->
      <section class="manifesto">
        <div class="manifesto-content">
          <h2>Potenciamos la Comunicación y el Lenguaje</h2>
          <p>
            A través de evaluaciones, terapias y orientación familiar, creo espacios donde cada persona pueda desarrollar sus habilidades comunicativas con seguridad y confianza.
          </p>
        </div>

        <div class="marquee-container">
          <div class="marquee-track">
            {[foto1, foto2, foto3, foto4, foto5, foto1, foto2, foto3, foto4, foto5].map((img, idx) => (
              <div class="marquee-item">
                <img src={img} alt={`Logopedia foto ${idx}`} />
              </div>
            ))}
          </div>
        </div>
        <button class="scroll-button">↓</button>
      </section>


      <!-- ===========================
          5. SERVICIOS ESPECIALIZADOS
      =========================== -->
      <section class="servicios-seccion" id="servicios">
        <h2>Nuestros Servicios</h2>

        <div class="servicios-carousel-wrapper">
          <div class="servicios-ref-cards-container">

            <!-- Card 1: Infantil -->
            <a href="/servicios/logopedia infantil" class="service-ref-card">
              <img src={card1} alt="Terapia de Lenguaje Infantil" class="card-ref-bg-image" loading="lazy" />
              <div class="card-ref-content">
                <span class="card-ref-category">Servicio</span>
                <h3 class="card-ref-title">Logopedia Infantil</h3>
                <p class="card-ref-description">Tratamos los diversos problemas de habla, lenguaje y articulación en los más pequeños.</p>
                <span class="btn-saber-mas">Saber más</span>
              </div>
            </a>

            <!-- Card 2: Adultos -->
            <a href="/servicios/logopedia jovenes y adultos" class="service-ref-card">
              <img src={card2} alt="Terapia para Jovenes y Adultos" class="card-ref-bg-image" loading="lazy" />
              <div class="card-ref-content">
                <span class="card-ref-category">Servicio</span>
                <h3 class="card-ref-title">Logopedia Jovenes y adultos</h3>
                <p class="card-ref-description">Nunca es tarde para tratar las dificultades en la comunicación, habla, voz y deglución.</p>
                <span class="btn-saber-mas">Saber más</span>
              </div>
            </a>

            <!-- Card 3: Online -->
            <a href="/servicios/logopedia online" class="service-ref-card">
              <img src={card3} alt="Terapia del Lenguaje Online" class="card-ref-bg-image" loading="lazy" />
              <div class="card-ref-content">
                <span class="card-ref-category">Servicio</span>
                <h3 class="card-ref-title">Logopedia Online</h3>
                <p class="card-ref-description">Adaptamos nuestras sesiones presenciales para obtener el mismo resultado de manera virtual.</p>
                <span class="btn-saber-mas">Saber más</span>
              </div>
            </a>

            <!-- Card 4: Domicilio -->
            <a href="/servicios/logopedia a domicilio" class="service-ref-card">
              <img src={card4} alt="Atención Presencial a Domicilio" class="card-ref-bg-image" loading="lazy" />
              <div class="card-ref-content">
                <span class="card-ref-category">Servicio</span>
                <h3 class="card-ref-title">Logopedia a Domicilio</h3>
                <p class="card-ref-description">Acercamos nuestras evaluaciones y tratamientos a la comodidad de tu lugar de residencia.</p>
                <span class="btn-saber-mas">Saber más</span>
              </div>
            </a>

          </div>
        </div>
      </section>

    </div>
