---
import Icon from '../components/Icon.astro';
import heroImgAsset from '../assets/imagenes-sobremi/imagen-1.jpg';
const heroImg = heroImgAsset.src;
import his1Asset from '../assets/imagenes-sobremi/imagen-2.jpg';
const his1 = his1Asset.src;
import his2Asset from '../assets/imagenes-sobremi/imagen-3.jpg';
const his2 = his2Asset.src;
import his3Asset from '../assets/imagenes-sobremi/imagen-4.jpg';
const his3 = his3Asset.src;
import card1Asset from '../assets/imagenes-sobremi/imagen-5.jpg';
const card1 = card1Asset.src;
import card2Asset from '../assets/imagenes-sobremi/imagen-6.jpg';
const card2 = card2Asset.src;
import for1Asset from '../assets/imagenes-sobremi/FP-1.jpg';
const for1 = for1Asset.src;
import for2Asset from '../assets/imagenes-sobremi/FP-2.jpg';
const for2 = for2Asset.src;
import for3Asset from '../assets/imagenes-sobremi/FP-3.png';
const for3 = for3Asset.src;
import for4Asset from '../assets/imagenes-sobremi/FP-4.png';
const for4 = for4Asset.src;
import for5Asset from '../assets/imagenes-sobremi/FP-5.png';
const for5 = for5Asset.src;
const carouselSlides = [
    { img: his1, title: "Pasión Clínica", subtitle: "+10 Años de Experiencia" },
    { img: his2, title: "Rol de Madre", subtitle: "Inspiración en casa con mis 3 hijos" },
    { img: his3, title: "Empatía Real", subtitle: "Acompañamiento cercano a cada familia" },
  ];
const currentIndex = 0;
---
<div class="sobremi-page">

      <!-- ===========================
          CABECERA SOBRE MÍ
      =========================== -->
      <section class="sobremi-hero" style={{ 'background-image': `url(${heroImg})` }}>
        <div class="sobremi-hero-container-inner">
          <div class="sobremi-hero-content">
            <span class="sobremi-hero-subtitle">Tecnóloga Médica & Logopeda</span>
            <h1>Jenny Moscol</h1>
            <p>
              Uniendo el rigor de la ciencia clínica con la empatía inquebrantable de ser mamá de tres. Porque cada niño tiene su propio ritmo para conquistar el mundo a través de la voz.
            </p>
            <div class="sobremi-hero-buttons">
              <a href="#historia" class="sobremi-btn-hero">
                Conoce mi historia
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ===========================
          WAVE DE TRANSICIÓN
      =========================== -->
      <div class="wave-divider">
        <svg viewBox="0 0 1440 200" preserveAspectRatio="none">
          <path class="wave-back" d="M0,40 C320,160 800,-20 1440,100 L1440,200 L0,200 Z" />
          <path class="wave-mid" d="M0,110 C480,-10 960,170 1440,60 L1440,200 L0,200 Z" />
          <path class="wave-front" d="M0,80 C360,180 1080,20 1440,110 L1440,200 L0,200 Z" />
        </svg>
      </div>

      <!-- ===========================
          HISTORIA / BIOGRAFÍA HUMANA + CARRUSEL
      =========================== -->
      <section class="about-story-section" id="historia">
        <div class="story-container">
          <div class="story-text">
            <h2>Mi Historia:</h2>
            <p>
              Hola, soy <strong>Jenny Moscol</strong>. Mi camino en la logopedia y la tecnología médica no nació únicamente en las aulas universitarias de Perú y España, sino en la sala de estar de mi propia casa, lidiando con las risas, los llantos y las primeras palabras de mis tres hijos.
            </p>
            <p>
              Comprendo perfectamente la angustia de una madre cuando siente que su pequeño no se comunica como los demás, o la preocupación frente a un trastorno de deglución. Por eso, mi enfoque no busca imponer terapias rígidas; creamos puentes de confianza donde el niño se siente seguro para explorar su lenguaje y las familias recuperan la tranquilidad.
            </p>
            <p>
              Cada título colgado en mi pared representa horas de estudio, pero cada sonrisa de un paciente que logra decir "mamá" o comer sin miedo es el verdadero motor que impulsa mi vocación cada día.
            </p>
          </div>

          <div class="story-carousel-box">
            <div class="carousel-slides-container">
              {carouselSlides.map((slide, index) => (
                <div
                  class={`carousel-slide ${index === currentIndex ? "active" : ""}`}
                >
                  <img src={slide.img} alt={slide.title} />
                  <div class="carousel-caption">
                    <h3>{slide.title}</h3>
                    <p>{slide.subtitle}</p>
                  </div>
                </div>
              ))}
            </div>
            <div class="carousel-dots">
              {carouselSlides.map((_, index) => (
                <span
                  class={`dot ${index === currentIndex ? "active" : ""}`}
                  data-original-slide={index}
                ></span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ===========================
          SECCIÓN TRAYECTORIA GENERAL
      =========================== -->
      <section class="sm-trayectoria-section">

        <div class="sm-main-header">
          <h2>TRAYECTORIA PROFESIONAL</h2>
          <p>Mi experiencia y formación continua al servicio de la excelencia</p>
        </div>

        <!-- 1. FORMACIÓN PRÁCTICAS -->
        <div class="sm-block-wrapper">
          <h3 class="sm-block-title">Formación y Prácticas</h3>

          <div class="sm-cards-grid">

            <div class="sm-card">
              <span class="sm-badge-year">2014</span>
              <div class="sm-card-logo">
                <img src={for2} alt="Colegio 138" />
              </div>
              <div class="sm-card-details">
                <h4>Colegio 138</h4>
                <p>Prácticas en desarrollo del lenguaje y comunicación en entorno escolar.</p>
              </div>
            </div>

            <div class="sm-card">
              <span class="sm-badge-year">2015</span>
              <div class="sm-card-logo">
                <img src={for1} alt="Hospital FAP" />
              </div>
              <div class="sm-card-details">
                <h4>Hospital FAP</h4>
                <p>Internado de grado en evaluación y rehabilitación clínica.</p>
              </div>
            </div>

            <div class="sm-card">
              <span class="sm-badge-year">2016</span>
              <div class="sm-card-logo">
                <img src={for4} alt="UNFV" />
              </div>
              <div class="sm-card-details">
                <h4>UNFV</h4>
                <p>Tecnología Médica con especialidad en Lenguaje.</p>
              </div>
            </div>

            <div class="sm-card">
              <span class="sm-badge-year">2018</span>
              <div class="sm-card-logo">
                <img src={for3} alt="PUCP" />
              </div>
              <div class="sm-card-details">
                <h4>PUCP</h4>
                <p>Maestría en Perturbaciones de la Comunicación.</p>
              </div>
            </div>

            <div class="sm-card">
              <span class="sm-badge-year">2026</span>
              <div class="sm-card-logo">
                <img src={for5} alt="UAB Barcelona" />
              </div>
              <div class="sm-card-details">
                <h4>UAB (España)</h4>
                <p>Logopeda - Universitat Autònoma de Barcelona.</p>
              </div>
            </div>

          </div>
        </div>

        <!-- 2. EXPERIENCIA PROFESIONAL -->
<div class="sm-block-wrapper">
  <h3 class="sm-block-title">Experiencia Profesional</h3>

  <div class="sm-cards-grid">

    <!-- Kaen - Atención Privada -->
    <div class="sm-card">
      <span class="sm-badge-year">Atención Privada</span>
      <div class="sm-card-logo icon-mode">
        <Icon name="UserCheck" size={32} color="#d9825b" />
      </div>
      <div class="sm-card-details">
        <h4>Kaen</h4>
        <p>Intervención logopédica y clínica personalizada.</p>
      </div>
    </div>

    <!-- Yankan Awnasy ONG - Labor Social -->
    <div class="sm-card">
      <span class="sm-badge-year">Labor Social</span>
      <div class="sm-card-logo icon-mode">
        <Icon name="HeartHandshake" size={32} color="#d9825b" />
      </div>
      <div class="sm-card-details">
        <h4>Yankan Awnasy ONG</h4>
        <p>Apoyo profesional en terapia del lenguaje y desarrollo comunitario.</p>
      </div>
    </div>

    <!-- CPL Barcelona -->
    <div class="sm-card">
      <span class="sm-badge-year">Barcelona</span>
      <div class="sm-card-logo icon-mode">
        <Icon name="Building2" size={32} color="#d9825b" />
      </div>
      <div class="sm-card-details">
        <h4>CPL Barcelona</h4>
        <p>Centro de Psicología y Logopedia en Barcelona, España.</p>
      </div>
    </div>

    <!-- 26 Sentits Barcelona -->
    <div class="sm-card">
      <span class="sm-badge-year">Barcelona</span>
      <div class="sm-card-logo icon-mode">
        <Icon name="Sparkles" size={32} color="#d9825b" />
      </div>
      <div class="sm-card-details">
        <h4>26 Sentits Barcelona</h4>
        <p>Espacio multidisciplinar de terapia e intervención infantil.</p>
      </div>
    </div>

    <!-- Naxum Barcelona -->
    <div class="sm-card">
      <span class="sm-badge-year">Barcelona</span>
      <div class="sm-card-logo icon-mode">
        <Icon name="Stethoscope" size={32} color="#d9825b" />
      </div>
      <div class="sm-card-details">
        <h4>Naxum Barcelona</h4>
        <p>Atención clínica especializada en logopedia.</p>
      </div>
    </div>

  </div>
</div>

      </section>

    </div>
