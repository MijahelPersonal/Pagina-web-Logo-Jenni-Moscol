---
import './PreFooter.css';
import logo from '../assets/imagenes-prefooter/logo-jenny2.png';
---
<section class="pre-footer" aria-label="Contacto directo">
  <div class="pre-footer-container">
    <div class="pre-footer-brand">
      <img src={logo.src} alt="Jenny Moscol" class="brand-logo-img" loading="lazy" width={logo.width} height={logo.height}/>
      <div class="brand-text-container"><h2 class="brand-title">Jenny Moscol</h2><span class="brand-subtitle">LOGOPEDA</span></div>
    </div>
    <div class="pre-footer-socials"><span class="socials-title">HABLEMOS</span><div class="contact-links"><a href="mailto:contacto.jennymoscol@gmail.com">Escribir un correo ↗</a><a href="https://wa.me/34632241367" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></div></div>
  </div>
</section>
<style>.contact-links{display:flex;gap:20px;flex-wrap:wrap}.contact-links a{color:#fff;text-decoration:underline;text-underline-offset:4px;font-size:.9rem}</style>
