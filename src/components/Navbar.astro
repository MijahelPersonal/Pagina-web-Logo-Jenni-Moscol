---
import logoBlancoAsset from '../assets/imagenes-navbar/logo-jenny-blanco.png';
const logoBlanco = logoBlancoAsset.src;
import logoOscuroAsset from '../assets/imagenes-navbar/logo-jenny-oscuro.png';
const logoOscuro = logoOscuroAsset.src;
const scrolled = false, menuOpen = false;
---

      <div class="topbar">
        <div class="topbar-left">
          <span> +34 632 24 13 67</span>
          <span> contacto.jennymoscol@gmail.com</span>
        </div>
        <div class="topbar-right">
          <span>ES</span>
        </div>
      </div>

      <!-- Se añade dinámicamente la clase 'scrolled' según el estado -->
      <header class={`navbar ${scrolled ? "scrolled" : ""}`}>
        <div class="nav-container">
          <div class="logo">
            <a href="/" class="logo-link">

              <!-- Logo Blanco (Visible arriba cuando el fondo es oscuro/transparente) -->
              <img
                src={logoBlanco}
                alt="Jenny Moscol Logopeda"
                class="logo-img logo-blanco"
              />

              <!-- Logo Oscuro (Visible al bajar cuando el fondo es blanco) -->
              <img
                src={logoOscuro}
                alt="Jenny Moscol Logopeda"
                class="logo-img logo-oscuro"
              />

              <div class="logo-text">
                <h2>Jenny Moscol</h2>
                <span>LOGOPEDA</span>
              </div>
            </a>
          </div>

          <!-- Botón Hamburguesa para Móvil -->
          <button
            class={`menu-toggle ${menuOpen ? "active" : ""}`}
            aria-label="Menú de navegación"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>

          <ul class={`nav-links ${menuOpen ? "active" : ""}`}>
            <li>
              <a href="/">INICIO</a>
            </li>
            <li>
              <a href="/sobre-mi">SOBRE MI</a>
            </li>

            <!-- Menú Desplegable con eventos seguros -->
            <li
              class="nav-item-dropdown"
            >
              <button
                class="nav-dropdown-toggle"
              >
                SERVICIOS <span>▾</span>
              </button>

                <ul hidden data-original-dropdown class="dropdown-menu" style="display:none">
                  <li>
                    <a href="/servicios/logopedia infantil">
                      LOGOPEDIA INFANTIL
                    </a>
                  </li>
                  <li>
                    <a href="/servicios/logopedia jovenes y adultos">
                      LOGOP. JOVENES Y ADULTOS
                    </a>
                  </li>
                  <li>
                    <a href="/servicios/logopedia online">
                      LOGOPEDIA ONLINE
                    </a>
                  </li>
                  <li>
                    <a href="/servicios/logopedia a domicilio">
                      LOGOPEDIA A DOMICILIO
                    </a>
                  </li>
                </ul>
            </li>

            <li>
              <a href="/metodologia">METODOLOGIA</a>
            </li>
            <li>
              <a href="/blog">BLOG</a>
            </li>
            <li>
              <a href="/contacto">CONTACTO</a>
            </li>
          </ul>
        </div>
      </header>
